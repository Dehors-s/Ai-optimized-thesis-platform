{
  "version": 1,
  "note": "图表版式模板。id 用于引用；layout 是归一化坐标（原点左下）；shared 是必须跨面板统一的语义。",
  "templates": [
    {
      "id": "T01_single",
      "name": "单面板",
      "when": "只有一条比较或一个空间格局，加面板只会稀释结论",
      "panels": [1, 1],
      "layout": {"type": "single", "rects": {"main": [0.0, 0.0, 1.0, 1.0]}},
      "shared": [],
      "letters": false,
      "caption": "断言 + 怎么读 + 边界",
      "examples": ["GMD GPP 单图"],
      "tools": ["figspec:dot/line/bar/map"]
    },
    {
      "id": "T02_pair",
      "name": "左右对照",
      "when": "两组条件一一对照（本文 vs 对照、前 vs 后）",
      "panels": [2, 2],
      "layout": {"type": "row", "rects": {"left": [0.0, 0.0, 0.49, 1.0], "right": [0.51, 0.0, 0.49, 1.0]}},
      "shared": ["y 轴范围", "色标", "字号"],
      "letters": true,
      "caption": "两面板各一句断言，第三句说差异",
      "examples": ["Nature 冠层图 2(a)(b)"],
      "tools": ["figspec"]
    },
    {
      "id": "T03_triptych",
      "name": "三联",
      "when": "三个并列条件，或「输入—方法—结果」",
      "panels": [3, 3],
      "layout": {"type": "row", "rects": {"p1": [0.0, 0.0, 0.32, 1.0], "p2": [0.34, 0.0, 0.32, 1.0], "p3": [0.68, 0.0, 0.32, 1.0]}},
      "shared": ["y 轴范围", "色标"],
      "letters": true,
      "caption": "三句并列，最后一句收束",
      "examples": ["GMD GPP 图 1（3 张全球图）"],
      "tools": ["figspec"]
    },
    {
      "id": "T04_quad",
      "name": "四宫格",
      "when": "2×2 条件组合（两个因素各两水平）",
      "panels": [4, 4],
      "layout": {"type": "grid", "rows": 2, "cols": 2, "gap": 0.04},
      "shared": ["轴范围", "色标", "字号"],
      "letters": true,
      "caption": "按 (a)(b)(c)(d) 逐格一句，或图注列全",
      "examples": ["常见消融图"],
      "tools": ["figspec", "matplotlib GridSpec"]
    },
    {
      "id": "T05_matrix",
      "name": "矩阵小倍数",
      "when": "行=模型/样本，列=条件/分辨率；核心是横向/纵向可对照",
      "panels": [6, 16],
      "layout": {"type": "grid", "rows": 2, "cols": 7, "gap": 0.015,
                 "row_labels": true, "col_titles": true, "shared_colorbar": true},
      "shared": ["色标与范围", "轴范围", "行列标签只出现一次", "面板等宽等高"],
      "letters": true,
      "caption": "先说什么随行/列变化，再说什么不变",
      "examples": ["GMD 涡度图 2（2×7）"],
      "tools": ["matplotlib GridSpec", "figspec 面板", "Tavotto 拼版"]
    },
    {
      "id": "T06_smallmultiples",
      "name": "小倍数序列",
      "when": "一个变量沿有序条件渐变（参数扫描、时间推进）",
      "panels": [4, 12],
      "layout": {"type": "grid", "rows": 2, "cols": 4, "gap": 0.03,
                 "row_labels": true, "col_titles": true, "shared_colorbar": true},
      "shared": ["色标", "轴范围", "条件标题只出现一次"],
      "letters": true,
      "caption": "趋势 + 拐点 + 边界",
      "examples": ["分辨率扫描", "层数消融"],
      "tools": ["figspec", "matplotlib"]
    },
    {
      "id": "T07_focus_context",
      "name": "总览 + 细节",
      "when": "需要同时看空间格局与若干典型位置的细节",
      "panels": [3, 6],
      "layout": {"type": "focus",
                 "rects": {"main": [0.0, 0.34, 1.0, 0.64],
                           "i1": [0.0, 0.0, 0.31, 0.28], "i2": [0.345, 0.0, 0.31, 0.28], "i3": [0.69, 0.0, 0.31, 0.28]}},
      "shared": ["投影与范围", "配色", "字母对应关系"],
      "letters": true,
      "caption": "断言 + 字母对应哪几个区域 + 细节说明了什么",
      "examples": ["Nature 河流图 1（全球图 + 5 inset）", "Nature 中非生物量图 1"],
      "tools": ["figspec:map + inset 面板", "Tavotto 拼版"]
    },
    {
      "id": "T08_hero_strip",
      "name": "主图 + 条带",
      "when": "一张主结果图 + 一排小图补充（消融、失败案例）",
      "panels": [3, 6],
      "layout": {"type": "hero",
                 "rects": {"hero": [0.0, 0.32, 1.0, 0.66],
                           "s1": [0.0, 0.0, 0.23, 0.26], "s2": [0.255, 0.0, 0.23, 0.26],
                           "s3": [0.51, 0.0, 0.23, 0.26], "s4": [0.765, 0.0, 0.23, 0.26]}},
      "shared": ["主图与条带的变量定义", "配色"],
      "letters": true,
      "caption": "主图结论 + 条带补充了什么",
      "examples": ["主结果 + 失败案例"],
      "tools": ["figspec", "Tavotto"]
    },
    {
      "id": "T09_qualitative_grid",
      "name": "定性矩阵",
      "when": "定性结果：行=样本，列=方法，末列 GT",
      "panels": [6, 20],
      "layout": {"type": "qualitative", "rows": 4, "cols": 6,
                 "roi_each": true, "col_labels": "methods", "last_col": "Ground Truth"},
      "shared": ["同一 ROI 框", "同一裁切与缩放", "顶部类色标", "指标写图注"],
      "letters": false,
      "caption": "行是什么、列是什么、红框是什么、末列是什么；指标写括号",
      "examples": ["LOGCAN++ 图 5", "iFlame 图 5", "少样本分类图 8"],
      "tools": ["matplotlib imshow 网格", "Tavotto 拼版"]
    },
    {
      "id": "T10_architecture",
      "name": "架构/流程",
      "when": "系统怎么工作：主链 + 挂载模块 + 放大框",
      "panels": [1, 1],
      "layout": {"type": "architecture", "main_chain": [3, 7], "zooms": [1, 2]},
      "shared": ["同一视觉语法", "颜色编码角色", "图例 ≤2 个算子"],
      "letters": true,
      "caption": "主链讲流程，放大框讲机制；差异只标一处",
      "examples": ["HyperFree 图 1", "LOGCAN++ 图 2", "DCT-Mamba3D 图 2"],
      "tools": ["figspec:pipeline", "TikZ", "PowerPoint/Illustrator", "draw.io"]
    },
    {
      "id": "T11_timeseries_grid",
      "name": "时序网格",
      "when": "多个站点/条件的时间序列，双轴或共享时间轴",
      "panels": [2, 8],
      "layout": {"type": "grid", "rows": 2, "cols": 4, "gap": 0.03,
                 "shared_x": true, "dual_axis": true, "row_labels": false},
      "shared": ["时间轴", "左右轴范围", "季节线", "配色"],
      "letters": true,
      "caption": "先说相位/趋势是否一致，再说例外站点",
      "examples": ["Nature 冠层图 2(c)"],
      "tools": ["figspec:line", "matplotlib"]
    },
    {
      "id": "T12_mixed_stats",
      "name": "统计混合",
      "when": "分布 + 空间 + 关系三类证据要放在一张图里",
      "panels": [4, 10],
      "layout": {"type": "mixed",
                 "rects": {"a": [0.0, 0.55, 0.48, 0.43], "b": [0.52, 0.55, 0.48, 0.43],
                           "c": [0.0, 0.0, 1.0, 0.52]}},
      "shared": ["同一变量定义", "同一配色", "字号三档"],
      "letters": true,
      "caption": "三类证据各一句，最后一句说它们如何互相支持",
      "examples": ["Nature 冠层图 2（小提琴 + 地图 + 时序）"],
      "tools": ["figspec", "R patchwork", "Tavotto"]
    }
  ]
}
